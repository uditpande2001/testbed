    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/type> a ns1:Column ;
    ns1:dataType "str" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/uuid> a ns1:Column ;
    ns1:dataType "str" ;
