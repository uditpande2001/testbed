    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/classIds> a ns1:Column ;
    ns1:dataType "object" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/data> a ns1:Column ;
    ns1:dataType "object" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/dataObis> a ns1:Column ;
    ns1:dataType "object" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/dataTypes> a ns1:Column ;
    ns1:dataType "object" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/debugServerTime> a ns1:Column ;
    ns1:dataType "str" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/last_ntp_sync_time> a ns1:Column ;
    ns1:dataType "str" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/meterNumber> a ns1:Column ;
    ns1:dataType "str" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/meter_category> a ns1:Column ;
    ns1:dataType "str" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/meter_manufacturer> a ns1:Column ;
    ns1:dataType "str" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/meter_type> a ns1:Column ;
    ns1:dataType "str" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/nodeId> a ns1:Column ;
    ns1:dataType "int64" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/scalar> a ns1:Column ;
    ns1:dataType "object" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/scalarObis> a ns1:Column ;
    ns1:dataType "object" ;
    ns1:nullCount 0 .

<http://metadata-platform.com/dataset/meter-data/column/sensor_time> a ns1:Column ;
    ns1:dataType "str" ;
    ns1:nullCount 0 .

